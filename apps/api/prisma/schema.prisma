generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  REPORTER
  MODERATOR
}

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
}

enum SectionType {
  HERO
  ROW
  GALLERY
  VIDEO
  HEADLINES
}

model User {
  id        String        @id @default(cuid())
  name      String
  email     String        @unique
  password  String
  role      Role          @default(REPORTER)
  avatar    String?
  bio       String?
  active    Boolean       @default(true)
  articles  Article[]     @relation("ArticleAuthor")
  media     Media[]
  logs      ActivityLog[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Category {
  id        String            @id @default(cuid())
  name      String
  nameEn    String
  slug      String            @unique
  parentId  String?
  parent    Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]        @relation("CategoryTree")
  order     Int               @default(0)
  visible   Boolean           @default(true)
  articles  Article[]
  sections  HomepageSection[]
  createdAt DateTime          @default(now())
}

model Tag {
  id       String    @id @default(cuid())
  name     String
  nameEn   String
  slug     String    @unique
  articles Article[]
}

model Article {
  id             String        @id @default(cuid())
  title          String
  titleEn        String
  slug           String        @unique
  excerpt        String
  excerptEn      String
  body           String        @db.Text
  bodyEn         String        @db.Text
  status         ArticleStatus @default(DRAFT)
  isBreaking     Boolean       @default(false)
  featured       Boolean       @default(false)
  isHero         Boolean       @default(false)
  sectionLead    Boolean       @default(false)
  homeRank       Int?
  imageTone      String        @default("navy")
  featuredImage  String?
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  authorId       String
  author         User          @relation("ArticleAuthor", fields: [authorId], references: [id])
  authorName     String?
  tags           Tag[]
  viewCount      Int           @default(0)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  publishedAt    DateTime?
  comments       Comment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([categoryId])
  @@index([status])
}

model Media {
  id           String    @id @default(cuid())
  url          String
  type         MediaType @default(IMAGE)
  altText      String?
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())
}

model BreakingItem {
  id        String    @id @default(cuid())
  text      String
  textEn    String
  order     Int       @default(0)
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model HomepageSection {
  id         String      @id @default(cuid())
  type       SectionType
  title      String?
  titleEn    String?
  categoryId String?
  category   Category?   @relation(fields: [categoryId], references: [id])
  cardCount  Int         @default(6)
  order      Int         @default(0)
  visible    Boolean     @default(true)
}

model LiveTvSetting {
  id        String   @id @default("live-tv")
  streamUrl String   @default("")
  active    Boolean  @default(false)
  title     String   @default("লাইভ টিভি")
  titleEn   String   @default("Live TV")
  updatedAt DateTime @updatedAt
}

model EpaperEdition {
  id        String   @id @default(cuid())
  date      DateTime
  pdfUrl    String
  thumbnail String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}

model District {
  id        String       @id @default(cuid())
  name      String
  nameEn    String
  slug      String       @unique
  division  String
  lawyers   Lawyer[]
  donors    BloodDonor[]
  hospitals Hospital[]
}

/// Where a reader-submitted directory listing sits in the review queue.
/// Rows the admin entered directly are created APPROVED.
enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}

model Lawyer {
  id         String   @id @default(cuid())
  name       String
  spec       String
  specEn     String
  phone      String
  chamber    String?
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  createdAt  DateTime @default(now())

  // --- Bar Council credentials, collected so a listing can be verified ---
  barEnrollNo    String?
  enrolledOn     DateTime?
  /// Uploaded enrollment sanad / certificate.
  sanadUrl       String?
  barAssociation String?
  barMemberId    String?
  photo          String?

  // --- Reader submission + review ---
  accountId  String?
  account    Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  status     ListingStatus @default(APPROVED)
  reviewNote String?
  updatedAt  DateTime      @default(now()) @updatedAt

  @@index([status])
  @@index([accountId])
}

model BloodDonor {
  id           String    @id @default(cuid())
  name         String
  group        String
  phone        String
  districtId   String
  district     District  @relation(fields: [districtId], references: [id])
  lastDonation DateTime?
  createdAt    DateTime  @default(now())

  donorNo String?
  dob     DateTime?
  gender  String?
  address String?
  photo   String?

  // --- Reader submission + review ---
  accountId  String?
  account    Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  status     ListingStatus @default(APPROVED)
  reviewNote String?
  updatedAt  DateTime      @default(now()) @updatedAt

  /// Every recorded donation is one point of the donor's score, so the number
  /// stands on dated entries rather than on a figure someone typed in.
  donations BloodDonation[]
  likes     DonorLike[]

  @@index([status])
  @@index([group])
  @@index([accountId])
}

model BloodDonation {
  id        String     @id @default(cuid())
  donorId   String
  donor     BloodDonor @relation(fields: [donorId], references: [id], onDelete: Cascade)
  donatedOn DateTime
  place     String?
  /// Set once an admin has checked the entry.
  verified  Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([donorId])
}

model DonorLike {
  id        String     @id @default(cuid())
  donorId   String
  donor     BloodDonor @relation(fields: [donorId], references: [id], onDelete: Cascade)
  accountId String
  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  /// One like per reader per donor.
  @@unique([donorId, accountId])
}

model Hospital {
  id          String   @id @default(cuid())
  name        String
  /// GOVERNMENT | PRIVATE | SPECIALIZED | NGO
  type        String
  address     String
  districtId  String
  district    District @relation(fields: [districtId], references: [id])
  thana       String?
  hotline     String
  emergency24 Boolean  @default(false)
  photo       String?

  accountId  String?
  account    Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  status     ListingStatus @default(PENDING)
  reviewNote String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @default(now()) @updatedAt

  @@index([status])
  @@index([districtId])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Comment {
  id        String        @id @default(cuid())
  articleId String
  article   Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  body      String
  status    CommentStatus @default(PENDING)
  parentId  String?
  createdAt DateTime      @default(now())

  @@index([articleId])
  @@index([status])
}

model MenuItem {
  id       String     @id @default(cuid())
  label    String
  labelEn  String
  href     String?
  order    Int        @default(0)
  parentId String?
  parent   MenuItem?  @relation("MenuTree", fields: [parentId], references: [id])
  children MenuItem[] @relation("MenuTree")
  visible  Boolean    @default(true)
}

model AdSlot {
  id        String   @id @default(cuid())
  name      String
  placement String
  imageUrl  String?
  linkUrl   String?
  html      String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SiteSetting {
  key   String @id
  value Json
}

/// Who did what, and from where.
///
/// Sign-ins and failed sign-in attempts are written here, so a break-in
/// attempt leaves a trace instead of passing unnoticed. `detail` holds the
/// address that was tried when no account matched it.
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  detail    String?
  ip        String?
  userAgent String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action, createdAt])
  @@index([createdAt])
}

// --- Analytics ---
model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  device    String? // desktop | mobile | tablet
  browser   String?
  os        String?
  ip        String?
  country   String?
  city      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ip])
}

// --- Public advertiser accounts (separate from admin Users) ---
model Account {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  avatar    String?
  bio       String?
  city      String?
  createdAt DateTime @default(now())
  ads       Ad[]

  // Directory listings this reader submitted, each awaiting admin approval.
  lawyerListings   Lawyer[]
  donorListings    BloodDonor[]
  hospitalListings Hospital[]
  donorLikes       DonorLike[]
}

// --- Advertising ---
enum AdPlacement {
  HEADER
  SIDEBAR
  IN_ARTICLE
  FOOTER
  POPUP
}

enum AdStatus {
  PENDING // booked, awaiting payment/approval
  ACTIVE // approved & running
  REJECTED
  EXPIRED
}

model Ad {
  id          String      @id @default(cuid())
  name        String
  imageUrl    String
  linkUrl     String
  placement   AdPlacement @default(SIDEBAR)
  active      Boolean     @default(true)
  status      AdStatus    @default(ACTIVE)
  accountId   String?
  account     Account?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount      Int         @default(0) // total price paid, in BDT
  days        Int         @default(0)
  paid        Boolean     @default(false)
  impressions Int         @default(0)
  clicks      Int         @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime    @default(now())
  events      AdEvent[]

  @@index([placement, active])
  @@index([accountId])
  @@index([status])
}

enum AdEventType {
  IMPRESSION
  CLICK
}

/// One recorded ad event.
///
/// The Ad row keeps running totals so the site can read them cheaply, but a
/// counter alone cannot say what happened on which day, and cannot be audited
/// or corrected. An advertiser asking "how did my week go?" needs these rows.
model AdEvent {
  id        String      @id @default(cuid())
  adId      String
  ad        Ad          @relation(fields: [adId], references: [id], onDelete: Cascade)
  type      AdEventType
  ip        String?
  path      String?
  createdAt DateTime    @default(now())

  @@index([adId, createdAt])
  // Powers the "same reader, same ad, again already?" check.
  @@index([adId, type, ip, createdAt])
  @@index([createdAt])
}
